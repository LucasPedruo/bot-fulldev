NODE_ENV=development
TZ=America/Sao_Paulo

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

DATABASE_URL=postgres://fulldev:fulldev@postgres:5432/fulldev_bot

WHATSAPP_JOBS_GROUP_1=
WHATSAPP_JOBS_GROUP_2=
WHATSAPP_FACULTY_JOBS_GROUP=
WHATSAPP_EVENTS_GROUP=
WHATSAPP_NETWORKING_GROUP=
WHATSAPP_NETWORKING_GROUP_1=
WHATSAPP_NETWORKING_GROUP_2=
WHATSAPP_AUTH_DIR=data/whatsapp
WHATSAPP_AUTO_CONNECT=true
WHATSAPP_PAIRING_PHONE_NUMBER=

MESSAGE_INTERVAL_SECONDS=30
MESSAGE_MAX_RETRIES=3

JOBS_POLL_ENABLED=true
JOBS_MAX_PER_DAY=15
JOBICY_JOBS_ENABLED=true
JOBICY_JOBS_COUNT=50
REMOTIVE_JOBS_ENABLED=false
REMOTIVE_JOBS_COUNT=20
REMOTEOK_JOBS_ENABLED=false
REMOTEOK_JOBS_COUNT=20
ARBEITNOW_JOBS_ENABLED=false
ARBEITNOW_JOBS_COUNT=20
HIMALAYAS_JOBS_ENABLED=false
HIMALAYAS_JOBS_COUNT=20
GREENHOUSE_JOBS_ENABLED=false
GREENHOUSE_JOBS_COUNT=20
GREENHOUSE_BOARD_SLUGS=nubank,stone,quintoandar,gympass,ebanx,wildlifestudios,vtex,rdstation,inter,c6bank
JOBS_POLL_INTERVAL_MINUTES=5
EVENTS_POLL_INTERVAL_MINUTES=15
EVENTS_POLL_ENABLED=false
EVENTS_MAX_PER_DAY=10
EVENT_REMINDER_TIME=09:00
EVENT_PROMO_TIME=10:00
EVENT_CLEANUP_TIME=03:00
AGENDA_TECH_BRASIL_EVENTS_ENABLED=true
LUMA_EVENTS_ENABLED=false
EVENTOSTI_DEV_EVENTS_ENABLED=false
CAFEBUGADO_EVENTS_ENABLED=false
# PUPPETEER_EXECUTABLE_PATH left unset here on purpose - the Dockerfile sets it to the system
# Chromium path for the container; setting it here (even to empty) would override that via
# docker-compose's env_file precedence and break Puppeteer in the container.

NETWORKING_MORNING_TIME=08:00
NETWORKING_LUNCH_TIME=12:00
NETWORKING_SUMMARY_TIME=18:00
NETWORKING_NIGHT_TIME=20:00

QUIET_HOURS_START=00:00
QUIET_HOURS_END=07:00
NETWORKING_MENTION_MAX_PER_HOUR=5
NETWORKING_MENTION_COOLDOWN_HOURS=2
MENTION_REPLY_AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NETWORKING_SCHEDULED_ENABLED=false

# Auto-approve pending join requests on the networking groups. Requires the bot to be an admin of
# those groups. Requests whose number does not look like a real phone line are left pending for a
# human to decide - the bot never rejects anyone.
NETWORKING_AUTO_APPROVE_ENABLED=false
# WhatsApp's hard group member ceiling.
NETWORKING_GROUP_CAPACITY=1024
# Per-group ceilings, as "<jid>:<numero>,<jid>:<numero>". 1024 is NOT universal - groups linked to
# a Community hold more. Set an override for any group already above the default, otherwise the bot
# refuses to approve into it and starts posting the "group is full" notice while seats remain.
GROUP_CAPACITY_OVERRIDES=
# Also auto-approve join requests on the jobs groups, not only networking.
JOBS_AUTO_APPROVE_ENABLED=false
# Sweep interval that catches requests which arrived while the bot was offline.
NETWORKING_JOIN_REQUEST_POLL_MINUTES=15
# How often the "group is full, leaving costs you your slot" notice may repeat per group.
NETWORKING_WAITLIST_NOTICE_COOLDOWN_HOURS=24

# Faculty relay: reads the "Representantes de eixo" group (where the professors announce things)
# and posts a summary into the college community's "Eventos e oportunidades" group. The bot only
# reads the source group - it never posts there. Only messages sent by admins of the source group
# are relayed.
FACULTY_RELAY_ENABLED=false
WHATSAPP_EIXO_REPRESENTATIVES_GROUP=
WHATSAPP_FACULTY_EVENTS_GROUP=
# Wait this long after the last message before summarizing, so an announcement split across
# several messages is relayed as a single summary.
FACULTY_RELAY_DEBOUNCE_MINUTES=5

# Posts the current version plus its CHANGELOG.md entry to every configured group, once, the first
# time the bot boots on a version it has not announced before.
RELEASE_ANNOUNCEMENTS_ENABLED=false

# Introduces the bot when it is added to a group. Groups listed in the variables above get a short
# greeting; any other group also gets the FullDev community presentation.
GROUP_INTRODUCTION_ENABLED=false

# Accessibility: turns images and stickers posted in any group into a text description, so blind
# members using a screen reader get the content instead of silence. Requires a MULTIMODAL model -
# the text-only GROQ_MODEL rejects image payloads outright.
IMAGE_DESCRIPTION_ENABLED=false
GROQ_VISION_MODEL=qwen/qwen3.8-27b
IMAGE_DESCRIPTION_MAX_BYTES=3000000

# Networking moderation. Networking groups allow technology discussions, technical questions,
# career, project work and respectful tech debates. Off-topic subjects should go to Off Topic;
# politics, religion, discrimination, harassment, sensitive content and piracy links are removed.
# Group admins are never moderated. Requires the bot to be an admin of the networking groups.
NETWORKING_MODERATION_ENABLED=false
NETWORKING_MODERATION_STRIKE_LIMIT=3
NETWORKING_MODERATION_BLOCK_DAYS=14
