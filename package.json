{
  "name": "fulldev-bot",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "jobs:poll": "tsx src/jobs/cli/poll.ts",
    "events:poll": "tsx src/events/cli/poll.ts",
    "queue:enqueue-test": "tsx src/queue/cli/enqueue-test.ts",
    "whatsapp:list-groups": "tsx src/whatsapp/cli/list-groups.ts",
    "whatsapp:list-participants": "tsx src/whatsapp/cli/list-participants.ts",
    "whatsapp:send-test": "tsx src/whatsapp/cli/send-test.ts",
    "whatsapp:update-group-description": "tsx src/whatsapp/cli/update-group-description.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "link-preview-js": "^3.2.0",
    "node-cron": "^4.6.0",
    "pino": "^9.9.4",
    "postgres": "^3.4.7",
    "puppeteer": "^25.10.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.1",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
